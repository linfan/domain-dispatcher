# Global forward configuration (all values are optional with defaults shown below)
global:
  forward:
    max_idle_conns: 1000              # Default: 1000
    max_idle_conns_per_host: 100      # Default: 100
    max_conns_per_host: 100           # Default: 100
    idle_conn_timeout: 90s            # Default: 90s
    tls_handshake_timeout: 10s        # Default: 10s
    expect_continue_timeout: 1s       # Default: 1s
    response_header_timeout: 30s      # Default: 30s
    dial_timeout: 10s                 # Default: 10s
    dial_keep_alive: 30s              # Default: 30s
    request_timeout: 60s              # Default: 60s
    force_attempt_http2: true         # Default: true
  # Global SSL/TLS configuration (required for https listeners)
  ssl:
    cert_file: /path/to/server.crt    # Path to SSL certificate file
    key_file: /path/to/server.key     # Path to SSL private key file

# Listeners configuration
listeners:
  - port: 8080
    type: http                        # Protocol type: http (default) or https
    dispatch:
      # Type defaults to 'forward' if not specified
      - domain: abc-api.com
        forward_to: https://abc.com/api
      - domain: xyz-api.com
        forward_to: https://xyz.com/api
        type: forward
        # Optional: remove specified headers before forwarding
        remove_headers:
          - X-Forwarded-For
          - X-Real-IP
      # Mock rule: respond locally without contacting any upstream
      - domain: mock-api.com
        type: mock
        mock_status: 200              # Optional: HTTP status code (default 200)
        mock_headers:                 # Optional: response headers
          Content-Type: application/json
        mock_body: '{"status":"ok","message":"mock response"}'
  - port: 8081
    type: https                      # HTTPS listener using global SSL config
    dispatch:
      - domain: abc-api.com
        forward_to: https://abc-api.com:8080
        type: redirect
